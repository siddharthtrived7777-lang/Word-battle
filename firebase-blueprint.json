{
  "entities": {
    "Room": {
      "title": "Room",
      "description": "Multiplayer Word Battle game room state, settings, players map, clues, votes, and round outcome.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "5-character uppercase room code",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^[A-Z0-9]{5}$"
        },
        "hostId": {
          "type": "string",
          "description": "Firebase Auth UID of the current room host",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "phase": {
          "type": "string",
          "description": "Current game state machine phase",
          "enum": ["lobby", "reveal", "discussion", "voting", "result"]
        },
        "settings": {
          "type": "object",
          "description": "Host-configured category, round count, and imposter count"
        },
        "players": {
          "type": "object",
          "description": "Map of player UIDs to player state (max 10 players)"
        },
        "usedPairIds": {
          "type": "array",
          "description": "Word pair IDs already used in this session"
        },
        "roundConfig": {
          "type": "object",
          "description": "Active round word pair, roles, turn order, and timer"
        },
        "clues": {
          "type": "array",
          "description": "Optional typed clues submitted during discussion"
        },
        "votes": {
          "type": "object",
          "description": "Map of voter UID to suspected player UID"
        },
        "outcome": {
          "type": "object",
          "description": "Computed round winner, vote counts, and awarded points"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when room was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last room update"
        }
      },
      "required": [
        "code",
        "hostId",
        "phase",
        "settings",
        "players",
        "usedPairIds",
        "clues",
        "votes",
        "createdAt",
        "updatedAt"
      ]
    },
    "Signal": {
      "title": "Signal",
      "description": "WebRTC peer-to-peer voice signaling message (SDP offer/answer or ICE candidate).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["offer", "answer", "ice"]
        },
        "data": {
          "type": "object"
        },
        "timestamp": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "from", "to", "type", "data", "timestamp", "createdAt"]
    },
    "AnimalRoom": {
      "title": "AnimalRoom",
      "description": "2-player Guess the Animal room state, turn tracking, Q&A history, and finish outcome without exposing secret animals.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^[A-Z0-9]{5}$"
        },
        "hostId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "playerIds": {
          "type": "array",
          "description": "Exactly 1 or 2 player UIDs permitted in this room"
        },
        "players": {
          "type": "object",
          "description": "Map of up to 2 player profiles and pick status"
        },
        "phase": {
          "type": "string",
          "enum": ["lobby", "picking", "playing", "finished"]
        },
        "turnUid": {
          "type": "string"
        },
        "askedCategoriesThisTurn": {
          "type": "array"
        },
        "pendingQuestion": {
          "type": "object"
        },
        "pendingGuess": {
          "type": "object"
        },
        "history": {
          "type": "array"
        },
        "winnerUid": {
          "type": "string"
        },
        "revealedAnimals": {
          "type": "object",
          "description": "Empty until phase is finished, when each player reveals their own secret animal"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "code",
        "hostId",
        "playerIds",
        "players",
        "phase",
        "askedCategoriesThisTurn",
        "history",
        "revealedAnimals",
        "createdAt",
        "updatedAt"
      ]
    },
    "AnimalSecret": {
      "title": "AnimalSecret",
      "description": "Private secret animal choice owned and readable strictly by a single player UID.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "animalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "animalId", "updatedAt"]
    },
    "CharadesRoom": {
      "title": "CharadesRoom",
      "description": "Multiplayer Bollywood Dumb Charades room state, teams, roles, word progress metadata (no secret title), and scores.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^[A-Z0-9]{5}$"
        },
        "hostId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "playerIds": {
          "type": "array"
        },
        "players": {
          "type": "object"
        },
        "mode": {
          "type": "string",
          "enum": ["team", "individual"]
        },
        "teamNames": {
          "type": "object"
        },
        "phase": {
          "type": "string",
          "enum": ["lobby", "selecting_movie", "acting", "revealed", "paused"]
        },
        "pausedFromPhase": {
          "type": "string"
        },
        "roundNumber": {
          "type": "number"
        },
        "actingTeam": {
          "type": "string"
        },
        "guessingTeam": {
          "type": "string"
        },
        "actorIds": {
          "type": "array"
        },
        "movieGiverId": {
          "type": "string"
        },
        "guesserIds": {
          "type": "array"
        },
        "movieMeta": {
          "type": "object",
          "description": "Public hint metadata (word counts, lengths, completion flags) without the movie title."
        },
        "guessFeedback": {
          "type": "object"
        },
        "revealedMovie": {
          "type": "object",
          "description": "Null until phase is revealed."
        },
        "scores": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "code",
        "hostId",
        "playerIds",
        "players",
        "mode",
        "teamNames",
        "phase",
        "roundNumber",
        "actorIds",
        "guesserIds",
        "guessFeedback",
        "scores",
        "createdAt",
        "updatedAt"
      ]
    },
    "CharadesPrivateMovie": {
      "title": "CharadesPrivateMovie",
      "description": "Private Dumb Charades movie assignment readable strictly by the designated actor or movie giver.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "words": {
          "type": "array"
        },
        "category": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "difficulty": {
          "type": "string",
          "enum": ["Easy", "Medium", "Hard"]
        },
        "assignedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "title", "words", "category", "language", "difficulty", "assignedBy", "updatedAt"]
    },
    "CardRoom": {
      "title": "CardRoom",
      "description": "Unified multiplayer Playing Cards room state (UNO, Satyo, Mongoose, Gadha Chor), players public counts/scores, and shared table metadata without exposing private hands.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^[A-Z0-9]{5}$"
        },
        "hostId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "selectedGame": {
          "type": "string",
          "enum": ["uno", "satyo", "mongoose", "gadha_chor"]
        },
        "phase": {
          "type": "string",
          "enum": ["lobby", "playing", "finished"]
        },
        "settings": {
          "type": "object"
        },
        "playerIds": {
          "type": "array"
        },
        "players": {
          "type": "object"
        },
        "playerOrder": {
          "type": "array"
        },
        "table": {
          "type": "object",
          "description": "Shared public table state (uppermost discard/stack card, turn tracker, action logs, outcome)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "code",
        "hostId",
        "selectedGame",
        "phase",
        "settings",
        "playerIds",
        "players",
        "playerOrder",
        "createdAt",
        "updatedAt"
      ]
    },
    "CardHand": {
      "title": "CardHand",
      "description": "Private card hand owned and readable strictly by a single player UID.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "cards": {
          "type": "array"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "cards", "updatedAt"]
    },
    "CardDeck": {
      "title": "CardDeck",
      "description": "Shared un-dealt draw pile, full UNO discard stack, and Mongoose center stack hidden from room overview.",
      "type": "object",
      "properties": {
        "drawPile": {
          "type": "array"
        },
        "unoDiscard": {
          "type": "array"
        },
        "mongooseStack": {
          "type": "array"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["drawPile", "unoDiscard", "mongooseStack", "updatedAt"]
    },
    "CardTransfer": {
      "title": "CardTransfer",
      "description": "Ephemeral private card transfer (Gadha Chor blind pick, UNO penalty draw, Mongoose pile push) readable only by sender and recipient.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "reason": {
          "type": "string",
          "enum": ["gadha_pick", "uno_penalty", "mongoose_pile"]
        },
        "cards": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "from", "to", "reason", "cards", "createdAt"]
    }
  },
  "firestore": {
    "/rooms/{roomCode}": {
      "schema": { "$ref": "#/entities/Room" },
      "description": "Active Word Battle multiplayer game rooms keyed by 5-character room code."
    },
    "/rooms/{roomCode}/signals/{signalId}": {
      "schema": { "$ref": "#/entities/Signal" },
      "description": "Ephemeral WebRTC voice signaling payloads targeted to a specific player UID."
    },
    "/animal_rooms/{roomCode}": {
      "schema": { "$ref": "#/entities/AnimalRoom" },
      "description": "Active 2-player Guess the Animal rooms keyed by 5-character room code."
    },
    "/animal_rooms/{roomCode}/secrets/{uid}": {
      "schema": { "$ref": "#/entities/AnimalSecret" },
      "description": "Player-private secret animal document readable and writable strictly by its owner UID."
    },
    "/animal_rooms/{roomCode}/signals/{signalId}": {
      "schema": { "$ref": "#/entities/Signal" },
      "description": "Optional WebRTC voice signaling payloads between the 2 Guess the Animal players."
    },
    "/charades_rooms/{roomCode}": {
      "schema": { "$ref": "#/entities/CharadesRoom" },
      "description": "Active multiplayer Bollywood Dumb Charades rooms keyed by 5-character room code."
    },
    "/charades_rooms/{roomCode}/private_movie/{uid}": {
      "schema": { "$ref": "#/entities/CharadesPrivateMovie" },
      "description": "Private movie title & word assignment readable strictly by the recipient UID."
    },
    "/charades_rooms/{roomCode}/signals/{signalId}": {
      "schema": { "$ref": "#/entities/Signal" },
      "description": "WebRTC live video + voice signaling payloads between Dumb Charades room members."
    },
    "/card_rooms/{roomCode}": {
      "schema": { "$ref": "#/entities/CardRoom" },
      "description": "Active multiplayer Playing Cards rooms (UNO, Satyo, Mongoose, Gadha Chor) keyed by 5-character room code."
    },
    "/card_rooms/{roomCode}/hands/{uid}": {
      "schema": { "$ref": "#/entities/CardHand" },
      "description": "Player-private hand cards readable strictly by the owning player UID."
    },
    "/card_rooms/{roomCode}/deck/{docId}": {
      "schema": { "$ref": "#/entities/CardDeck" },
      "description": "Shared draw stockpile and card stacks for active card room rounds."
    },
    "/card_rooms/{roomCode}/card_transfers/{transferId}": {
      "schema": { "$ref": "#/entities/CardTransfer" },
      "description": "Ephemeral player-to-player card transfers readable only by sender and recipient."
    },
    "/card_rooms/{roomCode}/signals/{signalId}": {
      "schema": { "$ref": "#/entities/Signal" },
      "description": "WebRTC live voice chat signaling payloads between Playing Cards room members."
    }
  }
}
