rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRoomCode(code) {
      return code is string && code.size() == 5 && code.matches('^[A-Z0-9]{5}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // 3. Entity Validation Blueprints (Word Battle)
    function isValidSettings(settings) {
      return settings is map &&
        settings.keys().hasAll(['category', 'rounds', 'imposterCount']) &&
        settings.keys().hasOnly(['category', 'rounds', 'imposterCount']) &&
        settings.category is string &&
        settings.category.size() >= 1 &&
        settings.category.size() <= 40 &&
        settings.rounds in [3, 4, 5] &&
        settings.imposterCount in [1, 2];
    }

    function isValidRoom(data, roomCode) {
      return data.keys().hasAll([
          'code', 'hostId', 'phase', 'settings', 'players',
          'usedPairIds', 'clues', 'votes', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'code', 'hostId', 'phase', 'settings', 'players',
          'usedPairIds', 'roundConfig', 'clues', 'votes', 'outcome',
          'createdAt', 'updatedAt'
        ]) &&
        data.code == roomCode &&
        isValidRoomCode(data.code) &&
        isValidId(data.hostId) &&
        data.phase in ['lobby', 'reveal', 'discussion', 'voting', 'result'] &&
        isValidSettings(data.settings) &&
        data.players is map &&
        data.players.size() <= 10 &&
        data.usedPairIds is list &&
        data.usedPairIds.size() <= 140 &&
        (data.usedPairIds.size() == 0 || data.usedPairIds[0] is string) &&
        data.clues is list &&
        data.clues.size() <= 60 &&
        (data.clues.size() == 0 || data.clues[0] is map) &&
        data.votes is map &&
        data.votes.size() <= 10 &&
        (!('roundConfig' in data) || data.roundConfig == null || data.roundConfig is map) &&
        (!('outcome' in data) || data.outcome == null || data.outcome is map) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSignal(data, signalId) {
      return data.keys().hasAll(['id', 'from', 'to', 'type', 'data', 'timestamp', 'createdAt']) &&
        data.keys().hasOnly(['id', 'from', 'to', 'type', 'data', 'timestamp', 'createdAt']) &&
        data.id == signalId &&
        isValidId(data.id) &&
        isValidId(data.from) &&
        isValidId(data.to) &&
        data.from == request.auth.uid &&
        data.to != request.auth.uid &&
        data.type in ['offer', 'answer', 'ice'] &&
        data.data is map &&
        data.timestamp is number &&
        data.createdAt is timestamp;
    }

    // 4. Entity Validation Blueprints (Guess the Animal - Strictly 2 Players)
    function isValidAnimalRoom(data, roomCode) {
      return data.keys().hasAll([
          'code', 'hostId', 'playerIds', 'players', 'phase',
          'askedCategoriesThisTurn', 'history', 'revealedAnimals',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'code', 'hostId', 'playerIds', 'players', 'phase',
          'turnUid', 'askedCategoriesThisTurn', 'pendingQuestion',
          'pendingGuess', 'history', 'winnerUid', 'revealedAnimals',
          'createdAt', 'updatedAt'
        ]) &&
        data.code == roomCode &&
        isValidRoomCode(data.code) &&
        isValidId(data.hostId) &&
        data.playerIds is list &&
        data.playerIds.size() >= 1 &&
        data.playerIds.size() <= 2 &&
        data.players is map &&
        data.players.size() >= 1 &&
        data.players.size() <= 2 &&
        data.phase in ['lobby', 'picking', 'playing', 'finished'] &&
        (!('turnUid' in data) || data.turnUid == null || isValidId(data.turnUid)) &&
        data.askedCategoriesThisTurn is list &&
        data.askedCategoriesThisTurn.size() <= 6 &&
        (!('pendingQuestion' in data) || data.pendingQuestion == null || data.pendingQuestion is map) &&
        (!('pendingGuess' in data) || data.pendingGuess == null || data.pendingGuess is map) &&
        data.history is list &&
        data.history.size() <= 100 &&
        (!('winnerUid' in data) || data.winnerUid == null || isValidId(data.winnerUid)) &&
        data.revealedAnimals is map &&
        data.revealedAnimals.size() <= 2 &&
        (data.revealedAnimals.size() == 0 || data.phase == 'finished') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAnimalSecret(data, uid) {
      return data.keys().hasAll(['ownerId', 'animalId', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'animalId', 'updatedAt']) &&
        data.ownerId == uid &&
        isValidId(data.ownerId) &&
        data.animalId is string &&
        data.animalId.size() >= 1 &&
        data.animalId.size() <= 40 &&
        data.updatedAt is timestamp;
    }

    function isAnimalRoomMember(roomCode) {
      return exists(/databases/$(database)/documents/animal_rooms/$(roomCode)) &&
        request.auth.uid in get(/databases/$(database)/documents/animal_rooms/$(roomCode)).data.playerIds;
    }

    // 4b. Entity Validation Blueprints (Bollywood Dumb Charades)
    function isValidCharadesMovieMeta(meta) {
      return meta is map &&
        meta.keys().hasAll([
          'wordCount', 'wordLengths', 'completedWords',
          'category', 'language', 'difficulty', 'hintsEnabled'
        ]) &&
        meta.keys().hasOnly([
          'wordCount', 'wordLengths', 'completedWords',
          'category', 'language', 'difficulty', 'hintsEnabled'
        ]) &&
        meta.wordCount is number &&
        meta.wordCount >= 1 &&
        meta.wordCount <= 20 &&
        meta.wordLengths is list &&
        meta.wordLengths.size() <= 20 &&
        meta.completedWords is list &&
        meta.completedWords.size() <= 20 &&
        meta.category is string &&
        meta.category.size() >= 1 &&
        meta.category.size() <= 50 &&
        meta.language is string &&
        meta.language.size() >= 1 &&
        meta.language.size() <= 40 &&
        meta.difficulty in ['Easy', 'Medium', 'Hard'] &&
        meta.hintsEnabled is bool;
    }

    function isValidCharadesRoom(data, roomCode) {
      return data.keys().hasAll([
          'code', 'hostId', 'playerIds', 'players', 'mode', 'teamNames',
          'phase', 'roundNumber', 'actorIds', 'guesserIds', 'guessFeedback',
          'scores', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'code', 'hostId', 'playerIds', 'players', 'mode', 'teamNames',
          'phase', 'pausedFromPhase', 'roundNumber', 'actingTeam', 'guessingTeam',
          'actorIds', 'movieGiverId', 'guesserIds', 'movieMeta', 'guessFeedback',
          'revealedMovie', 'scores', 'createdAt', 'updatedAt'
        ]) &&
        data.code == roomCode &&
        isValidRoomCode(data.code) &&
        isValidId(data.hostId) &&
        data.playerIds is list &&
        data.playerIds.size() <= 10 &&
        data.players is map &&
        data.players.size() <= 10 &&
        data.mode in ['team', 'individual'] &&
        data.teamNames is map &&
        data.teamNames.keys().hasAll(['A', 'B']) &&
        data.teamNames.keys().hasOnly(['A', 'B']) &&
        data.phase in ['lobby', 'selecting_movie', 'acting', 'revealed', 'paused'] &&
        (!('pausedFromPhase' in data) || data.pausedFromPhase == null || data.pausedFromPhase in ['lobby', 'selecting_movie', 'acting', 'revealed']) &&
        data.roundNumber is number &&
        data.roundNumber >= 0 &&
        (!('actingTeam' in data) || data.actingTeam == null || data.actingTeam in ['A', 'B']) &&
        (!('guessingTeam' in data) || data.guessingTeam == null || data.guessingTeam in ['A', 'B']) &&
        data.actorIds is list &&
        data.actorIds.size() <= 10 &&
        (!('movieGiverId' in data) || data.movieGiverId == null || isValidId(data.movieGiverId)) &&
        data.guesserIds is list &&
        data.guesserIds.size() <= 10 &&
        (!('movieMeta' in data) || data.movieMeta == null || isValidCharadesMovieMeta(data.movieMeta)) &&
        data.guessFeedback is map &&
        (!('revealedMovie' in data) || data.revealedMovie == null || (data.phase == 'revealed' && data.revealedMovie is map)) &&
        data.scores is map &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCharadesPrivateMovie(data, uid) {
      return data.keys().hasAll([
          'ownerId', 'title', 'words', 'category', 'language',
          'difficulty', 'assignedBy', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'title', 'words', 'category', 'language',
          'difficulty', 'assignedBy', 'updatedAt'
        ]) &&
        data.ownerId == uid &&
        isValidId(data.ownerId) &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 120 &&
        data.words is list &&
        data.words.size() >= 1 &&
        data.words.size() <= 20 &&
        data.category is string &&
        data.language is string &&
        data.difficulty in ['Easy', 'Medium', 'Hard'] &&
        isValidId(data.assignedBy) &&
        data.updatedAt is timestamp;
    }

    function getCharadesRoom(roomCode) {
      return get(/databases/$(database)/documents/charades_rooms/$(roomCode));
    }

    function isCharadesRoomMember(roomCode) {
      return exists(/databases/$(database)/documents/charades_rooms/$(roomCode)) &&
        request.auth.uid in getCharadesRoom(roomCode).data.playerIds;
    }

    // 4c. Entity Validation Blueprints (Playing Cards Suite)
    function isValidCardRoom(data, roomCode) {
      return data.keys().hasAll([
          'code', 'hostId', 'selectedGame', 'phase', 'settings',
          'playerIds', 'players', 'playerOrder', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'code', 'hostId', 'selectedGame', 'phase', 'settings',
          'playerIds', 'players', 'playerOrder', 'table', 'createdAt', 'updatedAt'
        ]) &&
        data.code == roomCode &&
        isValidRoomCode(data.code) &&
        isValidId(data.hostId) &&
        data.selectedGame in ['uno', 'satyo', 'mongoose', 'gadha_chor'] &&
        data.phase in ['lobby', 'playing', 'finished'] &&
        data.settings is map &&
        data.playerIds is list &&
        data.playerIds.size() >= 1 &&
        data.playerIds.size() <= 8 &&
        data.players is map &&
        data.players.size() >= 1 &&
        data.players.size() <= 8 &&
        data.playerOrder is list &&
        data.playerOrder.size() <= 8 &&
        (!('table' in data) || data.table == null || data.table is map) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCardHand(data, uid) {
      return data.keys().hasAll(['ownerId', 'cards', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'cards', 'updatedAt']) &&
        data.ownerId == uid &&
        isValidId(data.ownerId) &&
        data.cards is list &&
        data.cards.size() <= 110 &&
        data.updatedAt is timestamp;
    }

    function isValidCardDeck(data) {
      return data.keys().hasAll(['drawPile', 'unoDiscard', 'mongooseStack', 'updatedAt']) &&
        data.keys().hasOnly(['drawPile', 'unoDiscard', 'mongooseStack', 'updatedAt']) &&
        data.drawPile is list &&
        data.drawPile.size() <= 110 &&
        data.unoDiscard is list &&
        data.unoDiscard.size() <= 110 &&
        data.mongooseStack is list &&
        data.mongooseStack.size() <= 60 &&
        data.updatedAt is timestamp;
    }

    function isValidCardTransfer(data, transferId) {
      return data.keys().hasAll(['id', 'from', 'to', 'reason', 'cards', 'createdAt']) &&
        data.keys().hasOnly(['id', 'from', 'to', 'reason', 'cards', 'createdAt']) &&
        data.id == transferId &&
        isValidId(data.id) &&
        isValidId(data.from) &&
        isValidId(data.to) &&
        data.from == request.auth.uid &&
        data.to != request.auth.uid &&
        data.reason in ['gadha_pick', 'uno_penalty', 'mongoose_pile'] &&
        data.cards is list &&
        data.cards.size() >= 1 &&
        data.cards.size() <= 60 &&
        data.createdAt is timestamp;
    }

    function getCardRoom(roomCode) {
      return get(/databases/$(database)/documents/card_rooms/$(roomCode));
    }

    function isCardRoomMember(roomCode) {
      return exists(/databases/$(database)/documents/card_rooms/$(roomCode)) &&
        request.auth.uid in getCardRoom(roomCode).data.playerIds;
    }

    // 5. Connection Validation Probe
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // 6. Word Battle Rooms Collection
    match /rooms/{roomCode} {
      allow get: if isVerifiedUser() && isValidRoomCode(roomCode);
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidRoomCode(roomCode) &&
        isValidRoom(incoming(), roomCode) &&
        incoming().hostId == request.auth.uid &&
        incoming().phase == 'lobby' &&
        incoming().players.keys().hasOnly([request.auth.uid]) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidRoomCode(roomCode) &&
        isValidRoom(incoming(), roomCode) &&
        incoming().code == existing().code &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action 1: Host manages room settings, phase transitions, host transfer, and score outcome
          (
            existing().hostId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'hostId', 'phase', 'settings', 'players', 'usedPairIds',
              'roundConfig', 'clues', 'votes', 'outcome', 'updatedAt'
            ])
          ) ||
          // Action 2: Joining player in lobby adds only their own UID to players
          (
            existing().phase == 'lobby' &&
            !(request.auth.uid in existing().players.keys()) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['players', 'updatedAt']) &&
            incoming().players.keys().hasAll(existing().players.keys()) &&
            incoming().players.diff(existing().players).affectedKeys().hasOnly([request.auth.uid])
          ) ||
          // Action 3: Existing member updates self (or leaves), submits clue, casts own vote, advances own active turn, or claims host if host left
          (
            request.auth.uid in existing().players.keys() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'players', 'clues', 'votes', 'roundConfig', 'phase', 'hostId', 'updatedAt'
            ]) &&
            (
              incoming().phase == existing().phase ||
              (
                existing().phase == 'discussion' &&
                incoming().phase == 'voting' &&
                existing().roundConfig != null &&
                existing().roundConfig.turnOrder[existing().roundConfig.currentTurnIndex] == request.auth.uid
              )
            ) &&
            (
              incoming().players == existing().players ||
              (
                incoming().players.diff(existing().players).affectedKeys().hasOnly([request.auth.uid]) &&
                (
                  !(request.auth.uid in incoming().players.keys()) ||
                  incoming().players[request.auth.uid].score == existing().players[request.auth.uid].score
                )
              )
            ) &&
            (
              incoming().votes == existing().votes ||
              (existing().phase == 'voting' && incoming().votes.diff(existing().votes).affectedKeys().hasOnly([request.auth.uid])) ||
              (existing().phase == 'discussion' && incoming().phase == 'voting' && incoming().votes.size() == 0)
            ) &&
            (
              incoming().roundConfig == existing().roundConfig ||
              (
                existing().phase == 'discussion' &&
                existing().roundConfig != null &&
                existing().roundConfig.turnOrder[existing().roundConfig.currentTurnIndex] == request.auth.uid
              )
            ) &&
            (
              incoming().hostId == existing().hostId ||
              (!(existing().hostId in incoming().players.keys()) && incoming().hostId == request.auth.uid)
            )
          )
        );

      allow delete: if isVerifiedUser() &&
        isValidRoomCode(roomCode) &&
        (
          existing().hostId == request.auth.uid ||
          (existing().players.size() <= 1 && request.auth.uid in existing().players.keys())
        );

      // WebRTC Signaling Subcollection (Word Battle)
      match /signals/{signalId} {
        allow get: if isVerifiedUser() &&
          isValidRoomCode(roomCode) &&
          isValidId(signalId) &&
          (existing().to == request.auth.uid || existing().from == request.auth.uid);

        allow list: if isVerifiedUser() &&
          resource.data.to == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isValidRoomCode(roomCode) &&
          isValidId(signalId) &&
          isValidSignal(incoming(), signalId) &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/rooms/$(roomCode));

        allow update: if false;

        allow delete: if isVerifiedUser() &&
          isValidRoomCode(roomCode) &&
          isValidId(signalId) &&
          (existing().to == request.auth.uid || existing().from == request.auth.uid);
      }
    }

    // 7. Guess the Animal Collection (Strictly 2-Player Isolation)
    match /animal_rooms/{roomCode} {
      // Only the 2 players in the room can read active game state; a 2nd player can read an open 1-player lobby to join
      allow get: if isVerifiedUser() &&
        isValidRoomCode(roomCode) &&
        (
          request.auth.uid in existing().playerIds ||
          (existing().phase == 'lobby' && existing().playerIds.size() < 2)
        );

      // Allows a disconnected player to query only their own active rooms to rejoin
      allow list: if isVerifiedUser() &&
        request.auth.uid in resource.data.playerIds;

      allow create: if isVerifiedUser() &&
        isValidRoomCode(roomCode) &&
        isValidAnimalRoom(incoming(), roomCode) &&
        incoming().hostId == request.auth.uid &&
        incoming().phase == 'lobby' &&
        incoming().playerIds.size() == 1 &&
        incoming().playerIds[0] == request.auth.uid &&
        incoming().players.keys().hasOnly([request.auth.uid]) &&
        incoming().revealedAnimals.size() == 0 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidRoomCode(roomCode) &&
        isValidAnimalRoom(incoming(), roomCode) &&
        incoming().code == existing().code &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action 1: 2nd player joining an open 1-player lobby
          (
            existing().phase == 'lobby' &&
            existing().playerIds.size() == 1 &&
            !(request.auth.uid in existing().playerIds) &&
            incoming().playerIds.size() == 2 &&
            incoming().playerIds.hasAll(existing().playerIds) &&
            request.auth.uid in incoming().playerIds &&
            incoming().diff(existing()).affectedKeys().hasOnly(['playerIds', 'players', 'updatedAt']) &&
            incoming().players.keys().hasAll(existing().players.keys()) &&
            incoming().players.diff(existing().players).affectedKeys().hasOnly([request.auth.uid])
          ) ||
          // Action 2: Only one of the 2 room members can write game state updates
          (
            request.auth.uid in existing().playerIds &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'hostId', 'playerIds', 'players', 'phase', 'turnUid',
              'askedCategoriesThisTurn', 'pendingQuestion', 'pendingGuess',
              'history', 'winnerUid', 'revealedAnimals', 'updatedAt'
            ]) &&
            (
              incoming().revealedAnimals == existing().revealedAnimals ||
              (incoming().phase == 'picking' && incoming().revealedAnimals.size() == 0) ||
              (incoming().phase == 'lobby' && incoming().revealedAnimals.size() == 0) ||
              (
                incoming().phase == 'finished' &&
                incoming().revealedAnimals.diff(existing().revealedAnimals).affectedKeys().hasOnly([request.auth.uid])
              )
            )
          )
        );

      allow delete: if isVerifiedUser() &&
        isValidRoomCode(roomCode) &&
        request.auth.uid in existing().playerIds;

      // Private Secret Animal Subcollection — NEVER readable by the opponent
      match /secrets/{uid} {
        allow get: if isVerifiedUser() &&
          isValidRoomCode(roomCode) &&
          isValidId(uid) &&
          request.auth.uid == uid &&
          isAnimalRoomMember(roomCode);

        allow list: if false;

        allow create, update: if isVerifiedUser() &&
          isValidRoomCode(roomCode) &&
          isValidId(uid) &&
          request.auth.uid == uid &&
          isValidAnimalSecret(incoming(), uid) &&
          incoming().updatedAt == request.time &&
          isAnimalRoomMember(roomCode);

        allow delete: if isVerifiedUser() &&
          isValidRoomCode(roomCode) &&
          isValidId(uid) &&
          request.auth.uid == uid;
      }

      // Optional 2-Player WebRTC Signaling Subcollection
      match /signals/{signalId} {
        allow get: if isVerifiedUser() &&
          isValidRoomCode(roomCode) &&
          isValidId(signalId) &&
          isAnimalRoomMember(roomCode) &&
          (existing().to == request.auth.uid || existing().from == request.auth.uid);

        allow list: if isVerifiedUser() &&
          resource.data.to == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isValidRoomCode(roomCode) &&
          isValidId(signalId) &&
          isValidSignal(incoming(), signalId) &&
          incoming().createdAt == request.time &&
          isAnimalRoomMember(roomCode);

        allow update: if false;

        allow delete: if isVerifiedUser() &&
          isValidRoomCode(roomCode) &&
          isValidId(signalId) &&
          (existing().to == request.auth.uid || existing().from == request.auth.uid);
      }
    }

    // 8. Bollywood Dumb Charades Collection
    match /charades_rooms/{roomCode} {
      allow get: if isVerifiedUser() && isValidRoomCode(roomCode);

      // Allows a disconnected player to query only their own active rooms to rejoin
      allow list: if isVerifiedUser() &&
        request.auth.uid in resource.data.playerIds;

      allow create: if isVerifiedUser() &&
        isValidRoomCode(roomCode) &&
        isValidCharadesRoom(incoming(), roomCode) &&
        incoming().hostId == request.auth.uid &&
        incoming().phase == 'lobby' &&
        incoming().playerIds.size() == 1 &&
        incoming().playerIds[0] == request.auth.uid &&
        incoming().players.keys().hasOnly([request.auth.uid]) &&
        (!('revealedMovie' in incoming()) || incoming().revealedMovie == null) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidRoomCode(roomCode) &&
        isValidCharadesRoom(incoming(), roomCode) &&
        incoming().code == existing().code &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action 1: Host manages teams, game mode, roles, round transitions, pause/restart
          (
            existing().hostId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'hostId', 'playerIds', 'players', 'mode', 'teamNames',
              'phase', 'pausedFromPhase', 'roundNumber', 'actingTeam', 'guessingTeam',
              'actorIds', 'movieGiverId', 'guesserIds', 'movieMeta', 'guessFeedback',
              'revealedMovie', 'scores', 'updatedAt'
            ])
          ) ||
          // Action 2: New player joining room (up to 10 players) adds only self
          (
            !(request.auth.uid in existing().playerIds) &&
            existing().playerIds.size() < 10 &&
            incoming().playerIds.size() == existing().playerIds.size() + 1 &&
            incoming().playerIds.hasAll(existing().playerIds) &&
            request.auth.uid in incoming().playerIds &&
            incoming().diff(existing()).affectedKeys().hasOnly(['playerIds', 'players', 'updatedAt']) &&
            incoming().players.keys().hasAll(existing().players.keys()) &&
            incoming().players.diff(existing().players).affectedKeys().hasOnly([request.auth.uid])
          ) ||
          // Action 3: Designated movie giver or actor updates movieMeta, acting phase, guess feedback, or reveal
          (
            (
              request.auth.uid == existing().movieGiverId ||
              request.auth.uid in existing().actorIds
            ) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'phase', 'movieMeta', 'guessFeedback', 'revealedMovie', 'scores', 'updatedAt'
            ]) &&
            incoming().phase in ['selecting_movie', 'acting', 'revealed']
          ) ||
          // Action 4: Room member updates own media/presence status, leaves room, or claims host if host left
          (
            request.auth.uid in existing().playerIds &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'playerIds', 'players', 'hostId', 'updatedAt'
            ]) &&
            (
              incoming().players == existing().players ||
              incoming().players.diff(existing().players).affectedKeys().hasOnly([request.auth.uid])
            ) &&
            (
              incoming().hostId == existing().hostId ||
              (!(existing().hostId in incoming().playerIds) && incoming().hostId == request.auth.uid)
            )
          )
        );

      allow delete: if isVerifiedUser() &&
        isValidRoomCode(roomCode) &&
        (
          existing().hostId == request.auth.uid ||
          (existing().playerIds.size() <= 1 && request.auth.uid in existing().playerIds)
        );

      // Private Movie Assignment — NEVER readable by guessing players or outsiders
      match /private_movie/{uid} {
        allow get: if isVerifiedUser() &&
          isValidRoomCode(roomCode) &&
          isValidId(uid) &&
          request.auth.uid == uid &&
          isCharadesRoomMember(roomCode);

        allow list: if false;

        allow create, update: if isVerifiedUser() &&
          isValidRoomCode(roomCode) &&
          isValidId(uid) &&
          isCharadesRoomMember(roomCode) &&
          isValidCharadesPrivateMovie(incoming(), uid) &&
          incoming().assignedBy == request.auth.uid &&
          incoming().updatedAt == request.time &&
          (
            request.auth.uid == getCharadesRoom(roomCode).data.movieGiverId ||
            (getCharadesRoom(roomCode).data.movieGiverId == null && request.auth.uid == getCharadesRoom(roomCode).data.hostId)
          ) &&
          (
            uid in getCharadesRoom(roomCode).data.actorIds ||
            uid == request.auth.uid
          );

        allow delete: if isVerifiedUser() &&
          isValidRoomCode(roomCode) &&
          isValidId(uid) &&
          (
            request.auth.uid == uid ||
            (
              isCharadesRoomMember(roomCode) &&
              (
                request.auth.uid == getCharadesRoom(roomCode).data.movieGiverId ||
                request.auth.uid == getCharadesRoom(roomCode).data.hostId
              )
            )
          );
      }

      // Live Video + Voice WebRTC Signaling Subcollection
      match /signals/{signalId} {
        allow get: if isVerifiedUser() &&
          isValidRoomCode(roomCode) &&
          isValidId(signalId) &&
          isCharadesRoomMember(roomCode) &&
          (existing().to == request.auth.uid || existing().from == request.auth.uid);

        allow list: if isVerifiedUser() &&
          resource.data.to == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isValidRoomCode(roomCode) &&
          isValidId(signalId) &&
          isValidSignal(incoming(), signalId) &&
          incoming().createdAt == request.time &&
          isCharadesRoomMember(roomCode);

        allow update: if false;

        allow delete: if isVerifiedUser() &&
          isValidRoomCode(roomCode) &&
          isValidId(signalId) &&
          (existing().to == request.auth.uid || existing().from == request.auth.uid);
      }
    }

    // 9. Playing Cards Collection (UNO, Satyo, Mongoose, Gadha Chor)
    match /card_rooms/{roomCode} {
      allow get: if isVerifiedUser() &&
        isValidRoomCode(roomCode) &&
        (
          request.auth.uid in existing().playerIds ||
          (existing().phase == 'lobby' && existing().playerIds.size() < 8)
        );

      // Allows a disconnected player to query only their own active rooms to rejoin
      allow list: if isVerifiedUser() &&
        request.auth.uid in resource.data.playerIds;

      allow create: if isVerifiedUser() &&
        isValidRoomCode(roomCode) &&
        isValidCardRoom(incoming(), roomCode) &&
        incoming().hostId == request.auth.uid &&
        incoming().phase == 'lobby' &&
        incoming().playerIds.size() == 1 &&
        incoming().playerIds[0] == request.auth.uid &&
        incoming().players.keys().hasOnly([request.auth.uid]) &&
        incoming().playerOrder.size() == 1 &&
        incoming().playerOrder[0] == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidRoomCode(roomCode) &&
        isValidCardRoom(incoming(), roomCode) &&
        incoming().code == existing().code &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action 1: New player joining an open lobby adds only self
          (
            existing().phase == 'lobby' &&
            !(request.auth.uid in existing().playerIds) &&
            existing().playerIds.size() < 8 &&
            incoming().playerIds.size() == existing().playerIds.size() + 1 &&
            incoming().playerIds.hasAll(existing().playerIds) &&
            request.auth.uid in incoming().playerIds &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'playerIds', 'players', 'playerOrder', 'updatedAt'
            ]) &&
            incoming().players.keys().hasAll(existing().players.keys()) &&
            incoming().players.diff(existing().players).affectedKeys().hasOnly([request.auth.uid])
          ) ||
          // Action 2: Room members update ready status, host settings/deals, active table actions, mute, leave, or host migration
          (
            request.auth.uid in existing().playerIds &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'hostId', 'selectedGame', 'phase', 'settings', 'playerIds',
              'players', 'playerOrder', 'table', 'updatedAt'
            ]) &&
            (
              existing().hostId == request.auth.uid ||
              (
                incoming().selectedGame == existing().selectedGame &&
                incoming().settings == existing().settings &&
                !(existing().phase in ['lobby', 'finished'] && incoming().phase == 'playing')
              )
            ) &&
            (
              incoming().hostId == existing().hostId ||
              existing().hostId == request.auth.uid ||
              (!(existing().hostId in incoming().playerIds) && incoming().hostId == request.auth.uid)
            )
          )
        );

      allow delete: if isVerifiedUser() &&
        isValidRoomCode(roomCode) &&
        (
          existing().hostId == request.auth.uid ||
          (existing().playerIds.size() <= 1 && request.auth.uid in existing().playerIds)
        );

      // Private Player Hand — NEVER readable by opponents
      match /hands/{uid} {
        allow get: if isVerifiedUser() &&
          isValidRoomCode(roomCode) &&
          isValidId(uid) &&
          request.auth.uid == uid &&
          isCardRoomMember(roomCode);

        allow list: if false;

        allow create, update: if isVerifiedUser() &&
          isValidRoomCode(roomCode) &&
          isValidId(uid) &&
          isCardRoomMember(roomCode) &&
          isValidCardHand(incoming(), uid) &&
          incoming().updatedAt == request.time &&
          (
            request.auth.uid == uid ||
            (
              getCardRoom(roomCode).data.hostId == request.auth.uid &&
              getCardRoom(roomCode).data.phase != 'playing'
            )
          );

        allow delete: if isVerifiedUser() &&
          isValidRoomCode(roomCode) &&
          isValidId(uid) &&
          (
            request.auth.uid == uid ||
            (
              isCardRoomMember(roomCode) &&
              getCardRoom(roomCode).data.hostId == request.auth.uid
            )
          );
      }

      // Shared Draw Stockpile & Stacks
      match /deck/{docId} {
        allow get: if isVerifiedUser() &&
          isValidRoomCode(roomCode) &&
          docId == 'state' &&
          isCardRoomMember(roomCode);

        allow list: if false;

        allow create, update: if isVerifiedUser() &&
          isValidRoomCode(roomCode) &&
          docId == 'state' &&
          isCardRoomMember(roomCode) &&
          isValidCardDeck(incoming()) &&
          incoming().updatedAt == request.time;

        allow delete: if isVerifiedUser() &&
          isValidRoomCode(roomCode) &&
          docId == 'state' &&
          isCardRoomMember(roomCode);
      }

      // Ephemeral Player-to-Player Card Transfers
      match /card_transfers/{transferId} {
        allow get: if isVerifiedUser() &&
          isValidRoomCode(roomCode) &&
          isValidId(transferId) &&
          isCardRoomMember(roomCode) &&
          (existing().to == request.auth.uid || existing().from == request.auth.uid);

        allow list: if isVerifiedUser() &&
          resource.data.to == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isValidRoomCode(roomCode) &&
          isValidId(transferId) &&
          isCardRoomMember(roomCode) &&
          isValidCardTransfer(incoming(), transferId) &&
          incoming().createdAt == request.time;

        allow update: if false;

        allow delete: if isVerifiedUser() &&
          isValidRoomCode(roomCode) &&
          isValidId(transferId) &&
          (existing().to == request.auth.uid || existing().from == request.auth.uid);
      }

      // Playing Cards Live Voice WebRTC Signaling Subcollection
      match /signals/{signalId} {
        allow get: if isVerifiedUser() &&
          isValidRoomCode(roomCode) &&
          isValidId(signalId) &&
          isCardRoomMember(roomCode) &&
          (existing().to == request.auth.uid || existing().from == request.auth.uid);

        allow list: if isVerifiedUser() &&
          resource.data.to == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isValidRoomCode(roomCode) &&
          isValidId(signalId) &&
          isValidSignal(incoming(), signalId) &&
          incoming().createdAt == request.time &&
          isCardRoomMember(roomCode);

        allow update: if false;

        allow delete: if isVerifiedUser() &&
          isValidRoomCode(roomCode) &&
          isValidId(signalId) &&
          (existing().to == request.auth.uid || existing().from == request.auth.uid);
      }
    }
  }
}
